# Jira Cloud Configuration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token_here

# Key that encrypts everything under .ai-context/ (a secret, like the token). `python cli.py` writes one at the first login.
# Share the same value with teammates who should read the same .ai-context/; losing it means re-syncing.
# JIRA_AI_CONTEXT_KEY=

# Asset Download Limits
MAX_ASSET_SIZE_MB=15

# Optional: where synced tickets are written (default: <this repo>/.ai-context).
# Point it at the workspace the agent works in, e.g. <WORKSPACE>/.ai-context. Its contents are encrypted;
# folder and file names (ticket keys, image names) are not, so keep it in that repo's .gitignore unless those may be public.
# AI_CONTEXT_DIR=

# Optional: JSON secrets file injected by a parent MCP hub ({"jira": {"base_url", "email", "api_token", "ai_context_key"}}).
# Priority for each JIRA_* value: process env > central JSON file > this .env.
# CENTRAL_CONFIG_PATH=
